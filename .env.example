# LLM API 配置
# 选择提供商: gemini、deepseek 或 openai
LLM_PROVIDER=gemini

# Google Gemini 配置（默认）
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# OpenAI 配置（备用）
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# DeepSeek 配置（使用 DeepSeek 时填写）
# LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=your_deepseek_api_key_here
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# 可选：启用跨进程/重启持久化限流；留空则使用线程安全内存后端
# RATE_LIMIT_DB_PATH=runtime/rate_limit.sqlite3

# 可选：启用跨进程/重启客户状态持久化（含消息历史）；留空则使用内存后端
# CUSTOMER_STATE_DB_PATH=runtime/customer_state.sqlite3

# 注意：上面两条持久化路径相互独立。要跨重启同时保留「客户状态」和「限流记录」，
# 需要两者都配置；只配其一会在重启后出现状态与限流不一致，启动时会打印 [WARNING] 提示。

# 人工恢复接口凭证（不要暴露给客户或提交真实值）
# HUMAN_OPERATOR_TOKEN=replace-with-operator-secret
